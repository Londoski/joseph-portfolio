generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  client      String?
  year        Int?
  role        String?
  thumbnail   String?
  videoUrl    String?
  gallery     String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  company     String?
  role        String?
  content     String
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  budgetRange String?
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SocialLink {
  id          String   @id @default(cuid())
  platform    String
  url         String
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id                   String   @id @default(cuid())
  siteName             String   @default("JOSEPH.")

  heroHeading          String   @default("FRAME YOUR STORY.")
  heroSubtitle         String   @default("Cinematographer - Videographer - Editor")
  heroCtaLabel         String   @default("View My Work")
  heroCtaLink          String   @default("/work")
  heroSecondaryCta     String   @default("Contact Me")
  heroSecondaryLink    String   @default("/contact")

  homeFeaturedEyebrow  String   @default("Featured Work")
  homeFeaturedTitle    String   @default("Selected Projects")
  homeServicesEyebrow  String   @default("What I Do")
  homeServicesTitle    String   @default("Services built for stories that need to be seen.")
  homeAboutEyebrow     String   @default("About")
  homeCtaTitle         String   @default("Got a project in mind?")
  homeCtaSubtitle      String   @default("Let us bring your vision to life.")
  homeCtaButton        String   @default("Start a Conversation")

  workEyebrow          String   @default("Portfolio")
  workTitle            String   @default("Selected Work")
  servicesEyebrow      String   @default("Services")
  servicesTitle        String   @default("What I Offer")
  servicesSubtitle     String   @default("End-to-end creative production from concept to final delivery.")
  aboutEyebrow         String   @default("About")
  contactEyebrow       String   @default("Contact")
  contactTitle         String   @default("Let us Talk")
  contactSubtitle      String   @default("Tell me about your project and I will get back to you.")

  navLinks             String   @default("[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"Work\",\"href\":\"/work\"},{\"label\":\"About\",\"href\":\"/about\"},{\"label\":\"Services\",\"href\":\"/services\"},{\"label\":\"Contact\",\"href\":\"/contact\"}]")
  navCtaLabel          String   @default("Let us Talk")

  formProjectTypes     String   @default("[\"Cinematography\",\"Videography\",\"Video Editing\",\"Commercial\",\"Social Media Content\",\"Creative Direction\",\"Other\"]")
  formBudgets          String   @default("[\"Under $500\",\"$500 - $1,000\",\"$1,000 - $5,000\",\"$5,000 - $10,000\",\"$10,000+\",\"Not sure yet\"]")
  formSuccessTitle     String   @default("Message sent")
  formSuccessText      String   @default("Thanks for reaching out. I will get back to you soon.")

  aboutName            String   @default("Joseph Chimaobi Egbuonu")
  aboutHeadline        String   @default("Creative Director & Cinematographer")
  aboutBio             String   @default("")
  aboutImage           String?
  aboutExperience      String?
  aboutSkills          String?
  aboutTools           String?
  aboutAvailability    String   @default("Available for projects")
  aboutLocation        String   @default("Lagos, Nigeria")
  aboutEmail           String   @default("")
  aboutPhone           String   @default("")

  contactEmail         String   @default("")
  contactPhone         String   @default("")
  whatsappNumber       String   @default("")
  whatsappQr           String?

  seoTitle             String   @default("Joseph Chimaobi Egbuonu - Creative Portfolio")
  seoDescription       String   @default("Cinematographer, Videographer & Creative Director")
  seoOgImage           String?

  footerNavigateTitle  String   @default("Navigate")
  footerConnectTitle   String   @default("Connect")
  footerText           String   @default("Copyright Joseph Chimaobi Egbuonu. All rights reserved.")
  previewToken   String?  @unique
  previewEnabled Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ThemeSettings {
  id        String   @id @default(cuid())
  mode      String   @default("dark")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}